#define MyAppName "@CMAKE_PROJECT_NAME@"
#define MyAppVersion "@CMAKE_PROJECT_VERSION@"
#define MyAppPublisher "@PLUGIN_AUTHOR@"
#define MyAppURL "@PLUGIN_WEBSITE@"

[Setup]
AppId={{@UUID_APP@}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={commonappdata}\obs-studio\plugins\{#MyAppName}
; Old installers stored the OBS application directory in the uninstall record.
UsePreviousAppDir=no
DisableDirPage=yes
AppendDefaultDirName=no
DefaultGroupName={#MyAppName}
OutputBaseFilename={#MyAppName}-{#MyAppVersion}-windows-installer
Compression=lzma
SolidCompression=yes
DirExistsWarning=no
AllowNoIcons=yes
PrivilegesRequired=admin
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
CloseApplications=yes
RestartApplications=no
WizardStyle=modern
WizardResizable=yes
SetupIconFile="../media/icon.ico"

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
Source: "..\release\Package\{#MyAppName}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\LICENSE"; Flags: dontcopy

[Icons]
Name: "{group}\{cm:ProgramOnTheWeb,{#MyAppName}}"; Filename: "{#MyAppURL}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"

[Code]
var
  ObsDirectory: String;
  CleanupFailed: Boolean;

procedure InitializeWizard();
var
  GPLText: AnsiString;
  Page: TOutputMsgMemoWizardPage;
begin
  ExtractTemporaryFile('LICENSE');
  LoadStringFromFile(ExpandConstant('{tmp}\LICENSE'), GPLText);
  Page := CreateOutputMsgMemoPage(wpWelcome,
    'License Information', 'Please review the license terms before installing {#MyAppName}',
    'This package requires OBS Studio 33 or newer. For portable OBS, use the portable ZIP. ' +
    'Press Page Down to see the rest of the agreement, then click Next to continue.',
    String(GPLText)
  );
end;

function GetObsDirectory(): String;
var
  InstallPath: String;
begin
  { /OBSDIR supports a custom non-portable OBS installation. }
  Result := ExpandConstant('{param:OBSDIR|}');
  if Result <> '' then begin
    Result := RemoveBackslashUnlessRoot(ExpandFileName(Result));
    exit;
  end;
  if RegQueryStringValue(HKLM64, 'SOFTWARE\OBS Studio', '', InstallPath) then begin
    if FileExists(AddBackslash(InstallPath) + 'bin\64bit\obs64.exe') then begin
      Result := RemoveBackslashUnlessRoot(ExpandFileName(InstallPath));
      exit;
    end;
  end;
  if RegQueryStringValue(HKLM32, 'SOFTWARE\OBS Studio', '', InstallPath) then begin
    if FileExists(AddBackslash(InstallPath) + 'bin\64bit\obs64.exe') then begin
      Result := RemoveBackslashUnlessRoot(ExpandFileName(InstallPath));
      exit;
    end;
  end;
  Result := ExpandConstant('{commonpf64}\obs-studio');
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  ObsFileName: String;
  ObsMS, ObsLS: Cardinal;
begin
  Result := '';
  if CompareText(RemoveBackslashUnlessRoot(ExpandConstant('{app}')),
      ExpandConstant('{commonappdata}\obs-studio\plugins\{#MyAppName}')) <> 0 then begin
    Result := 'This installer uses the standard ProgramData plugin location. Use the portable ZIP for portable OBS.';
    exit;
  end;

  ObsDirectory := GetObsDirectory();
  ObsFileName := AddBackslash(ObsDirectory) + 'bin\64bit\obs64.exe';
  if not FileExists(ObsFileName) then begin
    Result := 'OBS Studio was not found. Install OBS Studio 33 or newer first, or pass /OBSDIR="path to OBS" for a custom installation.';
    exit;
  end;
  if FileExists(AddBackslash(ObsDirectory) + 'portable_mode.txt') or
      FileExists(AddBackslash(ObsDirectory) + 'portable_mode') then begin
    Result := 'This OBS installation uses portable mode. Extract the portable ZIP into its root directory instead.';
    exit;
  end;
  if not GetVersionNumbers(ObsFileName, ObsMS, ObsLS) then begin
    Result := 'Failed to read the OBS Studio version from ' + ObsFileName;
    exit;
  end;
  if (ObsMS shr 16) < 33 then
    Result := 'OBS Studio 33 or newer is required by this plugin package.';
end;

procedure RegisterLegacyModule(FileName: String);
begin
#if VER < EncodeVer(7, 0, 0)
  RegisterExtraCloseApplicationsResource(True, FileName);
#else
  RegisterExtraCloseApplicationsResource(FileName);
#endif
end;

procedure RegisterExtraCloseApplicationsResources();
begin
  RegisterLegacyModule(AddBackslash(GetObsDirectory()) + 'obs-plugins\64bit\{#MyAppName}.dll');
  RegisterLegacyModule(ExpandConstant('{app}\bin\64bit\{#MyAppName}.dll'));
end;

procedure RemoveLegacyFile(FileName: String);
begin
  if FileExists(FileName) then begin
    if not DeleteFile(FileName) then begin
      CleanupFailed := True;
      Log('Could not remove legacy plugin file: ' + FileName);
    end;
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep <> ssPostInstall then
    exit;

  { Only this plugin's old binaries are removed, after the new files are installed.
    Shared OBS directories, core modules and user settings are never removed.
    Old data/obs-plugins resources are left intact; they cannot load a plugin. }
  RemoveLegacyFile(AddBackslash(ObsDirectory) + 'obs-plugins\64bit\{#MyAppName}.dll');
  RemoveLegacyFile(AddBackslash(ObsDirectory) + 'obs-plugins\64bit\{#MyAppName}.pdb');
  RemoveLegacyFile(ExpandConstant('{app}\bin\64bit\{#MyAppName}.dll'));
  RemoveLegacyFile(ExpandConstant('{app}\bin\64bit\{#MyAppName}.pdb'));
  RemoveDir(ExpandConstant('{app}\bin\64bit'));
  RemoveDir(ExpandConstant('{app}\bin'));

  if CleanupFailed then
    SuppressibleMsgBox('The new plugin was installed, but an old plugin file could not be removed. ' +
      'Close OBS and run this installer again to finish removing the legacy copy.', mbInformation, MB_OK, IDOK);
end;
